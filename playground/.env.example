# Copy this file to ".env" and adjust. ".env" is git-ignored; never commit real credentials.

# Application under test (defaults to the public OrangeHRM demo)
BASE_URL=https://opensource-demo.orangehrmlive.com

# Credentials for the standard test user
OHRM_USERNAME=Admin
OHRM_PASSWORD=admin123

# Display name shown in the dashboard header for that user
OHRM_DISPLAY_NAME=John Doe

# Optional: a locked account enables the "rejects a locked user" test (skipped when unset)
# OHRM_LOCKED_USERNAME=
# OHRM_LOCKED_PASSWORD=

# Optional: run Firefox and WebKit as well as Chromium
# CROSS_BROWSER=true
